# Normalisation des fins de ligne : LF dans le depot, natif dans la copie de
# travail. Les fichiers reecrits par Visual Studio sont forces en CRLF, sinon
# chaque ouverture de la solution produit un diff parasite.
* text=auto

*.cs      text diff=csharp
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.resx    text eol=crlf

*.sql     text
*.md      text diff=markdown
*.json    text
*.ps1     text eol=crlf

# Binaires : jamais de normalisation, jamais de diff textuel.
*.db   binary
*.dll  binary
*.exe  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
